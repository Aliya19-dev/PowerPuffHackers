// 3. 5-STEP PRODUCE WIZARD & AI GRADING
// -------------------------------------------------------------------
app.post('/api/produce/evaluate-quality', authenticate, upload.single('image'), (req, res) => {
  const { produce_name } = req.body;
  const isTomato = produce_name?.toLowerCase().includes('tomato');
  
  const regionalAvg = isTomato ? 28 : 24;
  const qualityAdj = 4; // Grade A bonus
  const demandAdj = 3;  // Nashik regional demand uplift
  const suggestedPrice = regionalAvg + qualityAdj + demandAdj;

  res.json({
    aiScore: 92,
    grade: 'A',
    regionalAverage: regionalAvg,
    qualityAdjustment: qualityAdj,
    demandAdjustment: demandAdj,
    suggestedFairPrice: suggestedPrice,
    unit: '₹/kg'
  });
});

